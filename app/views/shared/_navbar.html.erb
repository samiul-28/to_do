<div class="d-flex flex-column flex-shrink-0 p-3 bg-light" style="width: 250px; height: 100vh;">
  <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto link-dark text-decoration-none">
    <span class="fs-2">To-Do </span>
    <%= link_to "Add New Task", new_task_path, class: "btn btn-info" %>  
  </a>
  <hr>
  <ul class="nav nav-pills flex-column mb-auto">
     
    <li>
      <a href="/tasks" class="nav-link link-dark">
        <i class="bi bi-list-task"></i> All-Tasks
      </a>
    </li>
   
    <li>
      <a href="/tasks" class="nav-link link-dark">
        <i class="bi bi-list-task"></i> Tasks
      </a>
    </li>
     
   

    
   
    <div style="position: absolute; bottom: 20px;">
          <% if user_signed_in? %>
            <%= button_to "Logout", destroy_user_session_path, class: "btn btn-outline-danger", method: :delete %>
          <% else %>
            <%= link_to "Signup", new_user_registration_path, class: "btn btn-outline-secondary" %> |
            <%= link_to "Login", new_user_session_path, class: "btn btn-outline-success" %>

          <% end %>
    </div>
  </ul>
</div>
