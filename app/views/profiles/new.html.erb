<!-- app/views/profiles/new.html.erb -->
<h1>Create Profile</h1>
<%= form_with model: @profile, local: true do |form| %>
  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :bio %>
    <%= form.text_area :bio, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :location %>
    <%= form.text_field :location, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :picture %>
    <%= form.file_field :picture, class: 'form-control' %>
  </div>

  <%= form.submit 'Create Profile', class: 'btn btn-primary' %>
<% end %>
